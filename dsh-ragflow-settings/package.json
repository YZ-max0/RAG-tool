{
  "name": "@local/dsh-ragflow-settings",
  "version": "0.3.0",
  "private": true,
  "description": "Session-scoped RAGFlow knowledge-base selection plus the Host ragflow_retrieval tools it drives.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-store"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT"
}
